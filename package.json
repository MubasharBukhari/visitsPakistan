{
  "name": "visitspakistan",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "nx run-many -t dev --projects=web,api,cms --parallel=3",
    "dev:web": "nx run web:dev",
    "dev:api": "nx run api:dev",
    "dev:cms": "nx run cms:dev",
    "lint": "nx run-many -t lint && eslint tools tests *.mjs *.cjs",
    "typecheck": "nx run-many -t typecheck && tsc -p tsconfig.json --noEmit",
    "test": "nx run-many -t test",
    "test:integration": "nx run testing:integration",
    "build": "nx run-many -t build --parallel=2",
    "format": "prettier --write apps libs tools tests *.json *.mjs *.cjs *.ts *.yml .github docs/development docs/02-architecture/sprint-0-plan.md docs/adr/001[23456789]-*.md docs/02-architecture/canonical-graph-plan.md docs/02-architecture/cms-implementation-plan.md docs/02-architecture/destination-implementation-plan.md docs/02-architecture/sprint-1-plan.md docs/02-architecture/sprint-2-plan.md docs/02-architecture/sprint-3-plan.md",
    "format:check": "prettier --check apps libs tools tests *.json *.mjs *.cjs *.ts *.yml .github docs/development docs/02-architecture/sprint-0-plan.md docs/adr/001[23456789]-*.md docs/02-architecture/canonical-graph-plan.md docs/02-architecture/cms-implementation-plan.md docs/02-architecture/destination-implementation-plan.md docs/02-architecture/sprint-1-plan.md docs/02-architecture/sprint-2-plan.md docs/02-architecture/sprint-3-plan.md",
    "db:generate": "prisma generate",
    "db:migrate": "tsx tools/migrate.ts",
    "db:migrate:test": "tsx tools/migrate-test.ts",
    "infra:up": "docker compose up -d redis opensearch",
    "infra:down": "docker compose down",
    "postinstall": "prisma generate",
    "db:seed": "tsx tools/seed.ts",
    "cms:bootstrap": "tsx tools/cms-bootstrap.ts",
    "destinations:preview": "tsx tools/destination-preview.ts",
    "discovery:preview": "tsx tools/discovery-preview.ts",
    "search:sync": "tsx tools/search-index.ts sync",
    "search:reindex": "tsx tools/search-index.ts rebuild",
    "search:reconcile": "tsx tools/search-index.ts reconcile",
    "search:worker": "tsx tools/search-index.ts worker",
    "search:status": "tsx tools/search-index.ts status",
    "search:preview": "tsx tools/search-preview.ts"
  },
  "dependencies": {
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tabler/core": "1.6.1",
    "@tabler/icons-react": "3.48.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "next": "16.3.8",
    "otplib": "13.5.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.7",
    "@nx/eslint-plugin": "23.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "jest": "29.7.0",
    "nx": "23.2.1",
    "prettier": "3.8.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
