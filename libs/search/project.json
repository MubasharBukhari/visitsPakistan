{
  "name": "search",
  "sourceRoot": "libs/search/src",
  "projectType": "library",
  "tags": ["type:infrastructure"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/search"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/search/tsconfig.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/search/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/libs/search"]
    }
  }
}
