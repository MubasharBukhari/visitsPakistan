{
  "name": "cache",
  "sourceRoot": "libs/cache/src",
  "projectType": "library",
  "tags": ["type:infrastructure"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/cache"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cache/tsconfig.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cache/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/libs/cache"]
    }
  }
}
