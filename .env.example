# Development only; never use these credentials in production.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5433
DB_USER=visitspakistan
DB_PASS=visitspakistan
DB_NAME=visitspakistandb
DB_TEST_NAME=visitspakistandb_test
# Optional DATABASE_URL overrides DB_* for Prisma/API. Do not commit real URLs.
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
CMS_ORIGIN=http://localhost:3001
SWAGGER_ENABLED=true
DEPENDENCY_TIMEOUT_MS=3000

# Generate once: openssl rand -hex 32. Keep stable and private (encrypts staff MFA).
# CMS_MFA_KEY=
MEDIA_ROOT=.data/media

# Public origin for published canonical/OpenGraph URLs.
SITE_URL=http://localhost:3000

# Optional isolation prefix; keep stable for each deployment/database. Empty gives destinations_v1 etc.
SEARCH_INDEX_PREFIX=

# Production: optional writer URL with restricted indexing credentials. API uses read-only OPENSEARCH_URL.
# OPENSEARCH_INDEX_URL=

# Staff password recovery: local messages are private files, never public media.
PASSWORD_RESET_DIR=.data/staff-recovery
# Production requires authenticated TLS SMTP and an HTTPS CMS_ORIGIN.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=service-account
# SMTP_PASS=set-in-ignored-environment
# SMTP_FROM=staff@visitspakistan.com
